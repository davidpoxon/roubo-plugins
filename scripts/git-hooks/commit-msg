#!/bin/sh
# Roubo commit-msg hook: rejects commits missing a DCO Signed-off-by line
# matching the author's email. Mirrors roubo's
# .github/workflows/dco-reusable.yml so local and CI verdicts cannot diverge.
# See CONTRIBUTING.md "Developer Certificate of Origin" for the full
# rationale.
set -eu

msg_file=$1

# Skip merge commits (CI uses --no-merges; match that here).
git_dir=$(git rev-parse --git-dir)
if [ -f "$git_dir/MERGE_MSG" ]; then
  exit 0
fi

# Skip fixup/squash commits; the eventual rebased commit is what CI checks.
first_line=$(sed -n '1p' "$msg_file")
case "$first_line" in
  "fixup!"*|"squash!"*|"amend!"*)
    exit 0
    ;;
esac

# The author of the commit being made, as CI reads it (%ae). git exports the
# author to its hooks, so this honours --author, --amend and GIT_AUTHOR_EMAIL,
# and falls back to user.email.
author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
author_email=$(printf '%s' "$author_ident" | sed -n 's/.*<\(.*\)>.*/\1/p')
if [ -z "$author_email" ]; then
  echo "commit-msg hook: no author email is set; cannot verify DCO sign-off." >&2
  echo "Set it with: git config --global user.email you@example.com" >&2
  exit 1
fi

# Bot authors are exempt, as in CI. Keep this case in step with bot_authors
# in roubo's .github/workflows/dco-reusable.yml.
case "$author_email" in
  "49699333+dependabot[bot]@users.noreply.github.com" | \
  "354874856+poxon-agent[bot]@users.noreply.github.com")
    exit 0
    ;;
esac

# Escape ERE metacharacters in the email so plus-aliased or dotted emails
# compare as literal strings. Matches the escaping in roubo's
# .github/workflows/dco-reusable.yml.
escaped_email=$(printf '%s' "$author_email" | sed 's/[].[\\$*^+?()|{}]/\\&/g')

if grep -qiE "^Signed-off-by: .+<${escaped_email}>\$" "$msg_file"; then
  exit 0
fi

cat >&2 <<EOF

Commit rejected: missing DCO sign-off matching <${author_email}>.

Every commit in this repo must include a Signed-off-by line under the
Developer Certificate of Origin. The easiest fix:

  git commit -s ...

Or if you have already typed your message, re-run with --signoff:

  git commit --signoff ...

To amend the most recent commit:

  git commit --amend --no-edit --signoff

To sign off every commit on this branch:

  git rebase --signoff origin/main

See CONTRIBUTING.md "Developer Certificate of Origin (DCO)" for details.
EOF
exit 1
